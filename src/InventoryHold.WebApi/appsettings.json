{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true",
    "Database": "inventory_hold",
    "UseTransactions": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "inventory-hold",
    "InventoryTtlSeconds": 30
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672",
    "Exchange": "inventory.holds",
    "Queue": "inventory.holds.events"
  },
  "Holds": {
    "DurationMinutes": 15
  },
  "Workers": {
    "ExpirationSweepSeconds": 10,
    "ExpirationBatchSize": 100,
    "OutboxPollMilliseconds": 1000,
    "OutboxBatchSize": 100
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Swagger": {
    "Enabled": false
  }
}
